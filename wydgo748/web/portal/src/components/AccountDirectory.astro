<section id="account-directory" class="panel account-directory" aria-labelledby="account-directory-title">
  <div class="players-heading">
    <div>
      <span class="eyebrow">PERSISTENT RECORDS</span>
      <h2 id="account-directory-title">Accounts and characters</h2>
    </div>
    <form id="account-directory-form" class="search-form">
      <label class="sr-only" for="account-directory-search">Search accounts or characters</label>
      <input id="account-directory-search" maxlength="12" pattern="[a-zA-Z0-9]{0,12}" placeholder="Account or character" />
      <button class="button subtle" type="submit">Search</button>
    </form>
  </div>
  <p id="account-directory-status" class="account-directory-status" role="status" aria-live="polite">Waiting for a query.</p>
  <div class="table-scroll">
    <table class="account-directory-table">
      <thead><tr><th>ACCOUNT</th><th>PRESENCE</th><th>CHARACTERS</th><th>UPDATED</th></tr></thead>
      <tbody id="account-directory-rows"><tr><td colspan="4" class="empty">No query has been made.</td></tr></tbody>
    </table>
  </div>
  <footer class="table-footer">
    <span id="account-directory-page">Up to 20 accounts per query · Sorted by account</span>
    <div>
      <button id="account-directory-previous" class="button pager" type="button" disabled aria-label="Previous account page">←</button>
      <button id="account-directory-next" class="button pager" type="button" disabled aria-label="Next account page">→</button>
    </div>
  </footer>
</section>
