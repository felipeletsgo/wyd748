<section id="accounts" class="panel account-create" aria-labelledby="account-create-title">
  <div class="account-create-copy">
    <span class="eyebrow">PLAYER ACCOUNTS</span>
    <h2 id="account-create-title">Create an account compatible with the 7.48 client</h2>
    <p>Registration stores only the account and a password hash. Characters are created later in the game.</p>
    <ul>
      <li>Account: 4–12 letters or digits</li>
      <li>Password: 4–10 characters, no spaces</li>
      <li>The administrative PIN authorizes each registration</li>
    </ul>
  </div>
  <form id="account-create-form" class="account-create-form">
    <label for="new-account-username">New account</label>
    <input id="new-account-username" name="username" autocomplete="username" minlength="4" maxlength="12" pattern="[a-zA-Z0-9]{4,12}" required placeholder="4 to 12 letters or digits" />
    <div class="account-create-passwords">
      <div>
        <label for="new-account-password">Password</label>
        <input id="new-account-password" name="password" type="password" autocomplete="new-password" minlength="4" maxlength="10" pattern="[^\s]{4,10}" required placeholder="Game password" />
      </div>
      <div>
        <label for="new-account-confirmation">Confirm password</label>
        <input id="new-account-confirmation" name="passwordConfirmation" type="password" autocomplete="new-password" minlength="4" maxlength="10" pattern="[^\s]{4,10}" required placeholder="Repeat the password" />
      </div>
    </div>
    <label for="new-account-pin">Administrative PIN <span>6–12 digits</span></label>
    <input id="new-account-pin" name="adminPin" type="password" inputmode="numeric" autocomplete="off" pattern="[0-9]{6,12}" minlength="6" maxlength="12" required placeholder="000000" />
    <p id="account-create-message" class="form-message" role="status" aria-live="polite">The account can sign in to the game once created.</p>
    <button id="account-create-submit" class="button primary" disabled>Create account <span aria-hidden="true">↗</span></button>
  </form>
</section>
