<section id="player-teleport" class="panel events-panel" aria-labelledby="teleport-title">
  <div class="panel-heading"><h2 id="teleport-title">Moderation · teleport player</h2><span class="tag">TELEPORT</span></div>
  <div class="event-body">
    <p class="muted">Select “Teleport” from the player list. Public destinations only; unavailable in instances, war arenas, trades, or ghost shops.</p>
    <p id="teleport-target">No player selected.</p>
    <form id="teleport-form">
      <label for="teleport-destination">Destination city</label>
      <select id="teleport-destination" required disabled>
        <option value="armia">Armia</option><option value="azran">Azran</option>
        <option value="erion">Erion</option><option value="nippleheim">Nippleheim</option>
      </select>
      <label for="teleport-reason">Reason required</label>
      <input id="teleport-reason" minlength="3" maxlength="200" required placeholder="Describe the reason for teleporting" disabled />
      <button id="teleport-submit" class="button primary" type="submit" disabled>Confirm teleport</button>
      <button id="teleport-retry" class="button subtle" type="button" hidden>Check / retry the same operation</button>
    </form>
    <p id="teleport-message" class="form-message" role="status" aria-live="polite"></p>
  </div>
</section>
