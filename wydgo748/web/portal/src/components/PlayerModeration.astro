<section id="moderation" class="panel events-panel" aria-labelledby="moderation-title">
  <div class="panel-heading"><h2 id="moderation-title">Moderation · disconnect player</h2><span class="tag">KICK</span></div>
  <div class="event-body">
  <p class="muted">Select “Disconnect” from the player list. This ends the selected session but does not prevent another login.</p>
  <p id="kick-target">No player selected.</p>
  <form id="kick-form">
    <label for="kick-reason">Reason required</label>
    <input id="kick-reason" minlength="3" maxlength="200" required placeholder="Describe the reason for disconnecting" disabled />
    <button id="kick-submit" class="button primary" type="submit" disabled>Confirm disconnect</button>
    <button id="kick-retry" class="button subtle" type="button" hidden>Check / retry the same operation</button>
  </form>
  <p id="kick-message" class="form-message" role="status" aria-live="polite"></p>
  </div>
</section>
