<article id="runtime-charts" class="panel runtime-panel" aria-labelledby="runtime-title">
  <div class="panel-heading">
    <div><span class="eyebrow">PROCESS HISTORY</span><h2 id="runtime-title">Server load</h2></div>
    <div class="runtime-controls">
      <label class="sr-only" for="runtime-window">Time window</label>
      <select id="runtime-window"><option value="15m">15 minutes</option><option value="1h" selected>1 hour</option><option value="6h">6 hours</option><option value="24h">24 hours</option></select>
      <button id="runtime-refresh" class="button subtle" type="button">Refresh charts</button>
    </div>
  </div>
  <div class="event-body">
    <p id="runtime-breaker" class="runtime-breaker" role="status" aria-live="polite" hidden></p>
    <p class="muted">Sampled every 10 seconds inside the server process without querying the World; up to 24 hours are kept in memory and lost on restart. Latency values are the upper bound of the bucket holding the 99th percentile.</p>
    <div id="runtime-grid" class="runtime-grid"></div>
    <p id="runtime-status" class="muted">Not queried.</p>
  </div>
</article>
