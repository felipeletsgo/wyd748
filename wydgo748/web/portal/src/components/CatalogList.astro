---
import { catalog, classLabel, classNames } from '../lib/catalog';
interface Props { kind: 'items' | 'skills' | 'quests' }
const { kind } = Astro.props;
const entries = catalog[kind];
---
<section class="panel" data-catalog data-kind={kind} data-hash={catalog.contentHash}>
  <fieldset class="catalog-filters" disabled>
    <label class="sr-only" for="catalog-search">Search by name or ID</label><input id="catalog-search" data-search type="search" maxlength="64" placeholder="Name or ID" autocomplete="off" />
    {kind === 'skills' && <><label class="sr-only" for="catalog-class">Class</label><select id="catalog-class" data-class><option value="">All classes</option>{classNames.map((name, index) => <option value={index}>{name}</option>)}<option value="shared">Shared</option></select></>}
    <button class="button ghost" data-reset type="button" disabled>Clear</button>
  </fieldset>
  <p class="status" data-status role="status" aria-live="polite">Loading search…</p>
  <noscript><p>Enable JavaScript to search all entries. The first 20 are shown below.</p></noscript>
  <div class="table-wrap"><table><thead><tr><th>ID</th><th>Name</th>{kind === 'skills' && <th>Class</th>}</tr></thead><tbody>{entries.slice(0, 20).map(entry => <tr><td>{entry.id}</td><td><a href={`/database/${kind}/${entry.id}/`}>{entry.name}</a></td>{'class' in entry && <td>{classLabel(entry.class)}</td>}</tr>)}</tbody></table></div>
  <div class="pagination"><button class="button ghost" data-previous type="button" disabled>Previous</button><span data-page aria-live="polite">1 / {Math.ceil(entries.length / 20)} · {entries.length} {kind}</span><button class="button ghost" data-next type="button" disabled>Next</button></div>
</section>
<script>
  import { mountCatalog } from '../lib/catalog-search';
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach(mountCatalog);
</script>
