---
import Public from '../layouts/Public.astro';
---
<Public title="Account">
  <section class="panel" id="login-panel">
    <span class="title">Login</span>
    <form id="login-form" class="form">
      <label for="login-username">Account</label><input id="login-username" name="username" autocomplete="username" required maxlength="12" pattern="[A-Za-z0-9]{1,12}" spellcheck="false" />
      <label for="login-password">Password</label><input id="login-password" name="password" type="password" autocomplete="current-password" required maxlength="10" />
      <div class="actions"><button type="submit" class="button" disabled>Login</button></div>
    </form>
    <p id="login-status" class="status" role="status" aria-live="polite"></p>
    <p class="links"><a href="/register/">New Account</a></p>
  </section>
  <section class="panel" id="profile-panel" hidden>
    <span class="title" id="profile-username">Account</span>
    <div class="row"><span id="profile-balance"></span><button type="button" class="button" id="logout-button">Logout</button></div>
    <div class="table-wrap"><table><thead><tr><th>Character</th><th>Class</th><th>Level</th><th>Evolution</th></tr></thead><tbody id="profile-characters"></tbody></table></div>
    <p class="status" id="profile-status" role="status" aria-live="polite"></p>
  </section>
</Public>
