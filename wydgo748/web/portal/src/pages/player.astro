---
import Public from '../layouts/Public.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '0x4AAAAAAFUuBWIVQX0iBfhZ';
---
<Public title="Account">
  <section class="panel" id="login-panel">
    <span class="title">Login</span>
    <form id="login-form" class="form">
      <label for="login-username">Account</label><input id="login-username" name="username" autocomplete="username" required maxlength="12" pattern="[A-Za-z0-9]{1,12}" spellcheck="false" />
      <label for="login-password">Password</label><input id="login-password" name="password" type="password" autocomplete="current-password" required maxlength="10" />
      <div id="login-challenge" data-sitekey={turnstileSiteKey} data-action="login"></div>
      <noscript>JavaScript and human verification are required to sign in.</noscript>
      <div class="actions"><button type="submit" class="button" disabled>Login</button></div>
    </form>
    <p id="login-status" class="status" role="status" aria-live="polite"></p>
    <p class="links"><a href="/register/">New Account</a></p>
  </section>
  <section class="panel" id="profile-panel" hidden>
    <span class="title" id="profile-username">Account</span>
    <div class="row"><span id="profile-balance"></span><button type="button" class="button" id="logout-button">Logout</button></div>
    <p id="profile-created" class="muted"></p>
    <p id="profile-asof" class="muted"></p>
    <p class="muted">Saved data, not live game state.</p>
    <div class="table-wrap"><table><thead><tr><th>Character</th><th>Class</th><th>Level</th><th>Evolution</th></tr></thead><tbody id="profile-characters"></tbody></table></div>
    <p class="status" id="profile-status" role="status" aria-live="polite"></p>
    <section id="character-panel" class="character-detail" hidden aria-labelledby="character-title">
      <div class="row"><h2 id="character-title">Character</h2><button type="button" class="button" id="character-refresh" disabled>Refresh</button></div>
      <dl id="character-stats" class="catalog-values"></dl>
      <h3>Equipment</h3>
      <ul id="character-equipment" class="equipment-grid" aria-label="Saved equipment"></ul>
      <p id="character-asof" class="muted"></p>
      <p id="character-status" class="status" role="status" aria-live="polite"></p>
      <details class="disclosure" id="arch-advisor" hidden><summary>Arch ascension</summary>
        <dl id="arch-checks" class="catalog-values"></dl>
        <p id="arch-status" class="status" role="status" aria-live="polite"></p>
      </details>
      <details class="disclosure" id="celestial-advisor" hidden><summary>Celestial ascension</summary>
        <dl id="celestial-checks" class="catalog-values"></dl>
        <p id="celestial-status" class="status" role="status" aria-live="polite"></p>
      </details>
      <details class="disclosure" id="subcelestial-advisor" hidden><summary>SubCelestial creation</summary>
        <dl id="subcelestial-checks" class="catalog-values"></dl>
        <p id="subcelestial-status" class="status" role="status" aria-live="polite"></p>
      </details>
      <details class="disclosure" id="inventory-view"><summary>Inventory</summary>
        <div class="row"><span id="inventory-summary" class="muted"></span><button type="button" class="button" id="inventory-refresh" disabled>Refresh</button></div>
        <ul id="inventory-items" class="equipment-grid" aria-label="Saved inventory"></ul>
        <p id="inventory-asof" class="muted"></p><p id="inventory-status" class="status" role="status" aria-live="polite"></p>
      </details>
    </section>
    <details class="disclosure" id="cargo-view"><summary>Cargo</summary>
      <div class="row"><span id="cargo-summary" class="muted"></span><button type="button" class="button" id="cargo-refresh" disabled>Refresh</button></div>
      <ul id="cargo-items" class="equipment-grid" aria-label="Saved Cargo"></ul>
      <p id="cargo-asof" class="muted"></p><p id="cargo-status" class="status" role="status" aria-live="polite"></p>
    </details>
    <section class="character-detail" id="guild-panel" hidden aria-labelledby="guild-title">
      <h2 id="guild-title">Guild</h2>
      <div id="guild-details"></div>
      <img id="guild-mark" class="guild-mark" alt="Current guild mark" width="64" height="48" hidden />
      <form id="guild-mark-form" class="form guild-mark-form" hidden>
        <label for="guild-mark-file">Guild mark</label>
        <input id="guild-mark-file" name="mark" type="file" accept=".bmp,image/bmp,image/png,image/jpeg,image/gif" required />
        <p class="muted guild-mark-help">Send a ready-to-use 16x12, 24-bit BMP. Other images (PNG, JPEG, GIF or BMP up to 64 KB) are converted to 16x12 automatically.</p>
        <div class="actions"><button type="submit" class="button">Send guild mark</button><button type="button" class="button" id="guild-mark-remove" hidden>Remove guild mark</button></div>
      </form>
      <p class="status" id="guild-status" role="status" aria-live="polite"></p>
    </section>
    <details class="disclosure"><summary>Website sessions</summary>
    <p class="muted">Website access only. Your game and staff sessions stay connected.</p>
    <div class="actions">
      <button type="button" class="button" id="sessions-refresh">Refresh</button>
      <button type="button" class="button" id="sessions-revoke-all">Logout all, including this session</button>
    </div>
    <ul class="session-list" id="account-sessions"></ul>
    <p class="status" id="sessions-status" role="status" aria-live="polite"></p>
    </details>
  </section>
</Public>
