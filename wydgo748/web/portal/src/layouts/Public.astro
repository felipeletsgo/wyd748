---
import '../styles/public.css';
import '../styles/wyd-theme.css';
interface Props { title: string }
const { title } = Astro.props;
const links = [['/', 'Home'], ['/register/', 'New Account'], ['/player/', 'Account'], ['/ranking/', 'Ranking'], ['/download/', 'Download']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="WYD 7.48 — account, ranking and client download." /><meta name="theme-color" content="#101211" />
    <title>{title} · WYD 7.48</title><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" class="logo" aria-label="WYD 7.48 home"><img src="/ui/logo.png" alt="WYD" width="505" height="164" /></a>
      <nav aria-label="Main navigation">{links.map(([url, label]) => <a class="button" href={url} aria-current={Astro.url.pathname === url ? 'page' : undefined}>{label}</a>)}</nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">WYD 7.48 · With Your Destiny</footer>
    <script>
      import '../lib/player-portal';
    </script>
  </body>
</html>
