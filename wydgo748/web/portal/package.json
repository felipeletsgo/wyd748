{
  "name": "wyd-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run catalog && astro dev --host 127.0.0.1",
    "catalog": "go run ../../cmd/web-export -data-dir ../../data -output src/data/catalog.generated.json",
    "generate": "openapi-typescript ../../api/openapi.yaml -o src/lib/api.generated.ts",
    "check": "npm run catalog && astro check",
    "build": "npm run catalog && astro build",
    "test": "node --test tests/*.test.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": { "astro": "7.3.2" },
  "devDependencies": { "@astrojs/check": "0.9.10", "typescript": "5.9.3", "openapi-typescript": "7.13.0" }
}
