{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git clean *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git worktree add *)",
      "Bash(gh pr create *)",
      "PowerShell(git reset --hard)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push *-f)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git switch -c *)",
      "PowerShell(git worktree add *)",
      "PowerShell(gh pr create *)",
      "PowerShell(*Start-Process*WYD*)",
      "PowerShell(*Start-Process*project.exe*)",
      "PowerShell(*Invoke-Item*WYD*)",
      "EnterWorktree",
      "Edit(/references/**)"
    ]
  }
}
