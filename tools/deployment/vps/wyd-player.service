[Unit]
Description=WYD public player API (no staff or gameplay commands)
After=network.target postgresql@18-main.service wyd-game.service
Requires=postgresql@18-main.service

[Service]
Type=simple
User=wyd-player
Group=wyd-player
WorkingDirectory=/srv/wyd-go/current
EnvironmentFile=/etc/wyd-go/player.env
ExecStart=/srv/wyd-go/current/game/wyd-player-api -origin https://wyd.forjago.com -trust-loopback-proxy
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=50%
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
