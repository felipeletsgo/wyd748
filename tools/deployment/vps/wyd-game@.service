[Unit]
# One game process per channel (W9 phase 5). %i is the channel number. A full
# release installs this template; wyd-channel-processes enable switches from
# wyd-game.service to wyd-game@1 and wyd-game@2 (DOCS/server/server-correction-plan.md).
Description=WYD authoritative native game server, channel %i
After=network.target postgresql@18-main.service
# Wants, not Requires: a database restart must not stop the game. The server
# rejects writes and reports readiness 503 until PostgreSQL returns (W5/D10).
Wants=postgresql@18-main.service
Conflicts=wyd-game.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=wyd-game
Group=wyd-game
WorkingDirectory=/srv/wyd-go/current/game
EnvironmentFile=/etc/wyd-go/game.env
# server-ch%i.txt sets channel_id=%i, channel_peers, its own listener, staff
# panel and debug addresses, and its share of database_max_conns.
ExecStart=/srv/wyd-go/current/game/wyd-server -config /etc/wyd-go/server-ch%i.txt
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wyd-go /var/lib/wyd-go-public
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=800M
CPUQuota=100%
TasksMax=128
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
